# Algolia (public search — use a restricted search-only key, not admin)
PUBLIC_ALGOLIA_APP_ID=
PUBLIC_ALGOLIA_API_KEY=
PUBLIC_ALGOLIA_INDEX=prod_devdocs
PUBLIC_ALGOLIA_INDEX_STYLE_GUIDE=prod_devdocs_styleguide

# Cloudflare & AI Gateway
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_API_BASE_URL=
CF_AIG_TOKEN=your-token-here

# Cloudflare Access (tooling)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# GitHub
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Jira (optional tooling)
JIRA_AUTH_TOKEN=
JIRA_HOSTNAME=

# Environment & CI Controls
NODE_ENV=development
CI=false
LOG_FORMAT=json

# Branch / debug
BRANCH_SLUG=
NODE_DEBUG=
VERBOSE=
RUN_LINK_CHECK=
REPORT_PATH=
CLIENT_ID=vane_guard_dev_client
USER_ID=vane_guard_dev_user
